# ==============================================================================
# QuickVault: Environment Configuration Template
# ==============================================================================

# 1. DATABASE (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Note: If left unset or set to file:./data/quickvault.db, QuickVault uses built-in embedded SQLite for zero-config local testing.
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL=true

# 2. AUTHENTICATION
# Secure random string of at least 32 characters (generate with: openssl rand -base64 32)
AUTH_SECRET=your-32-char-random-secret-key-change-this-for-production

# 3. CLOUDFLARE R2 FILE STORAGE
# Retrieve these credentials from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# Note: If left unset, QuickVault uses built-in local file storage in development mode.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=quickvault

# 4. APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

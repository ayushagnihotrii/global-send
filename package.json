{
  "name": "quickvault",
  "version": "0.1.0",
  "description": "Global Send Desktop Vault — High-Speed Encrypted Cloud Storage",
  "author": "Ayush Agnihotri",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --win --dir",
    "desktop:dist": "electron-builder --win",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "test:config": "npx tsx test_config.mjs",
    "test:globalsend": "npx tsx test_globalsend.mjs",
    "test:telegram": "npx tsx test_telegram_storage.mjs",
    "test:crypto": "npx tsx test_crypto.mjs",
    "test:phase1": "npx tsx test_phase1_resumable.mjs",
    "test:phase2": "npx tsx test_phase2_folders_trash.mjs",
    "test:phase3": "npx tsx test_phase3_shares_access.mjs",
    "test:phase4": "npx tsx test_phase4_trust_safety.mjs",
    "test:phase5": "npx tsx test_phase5_previews_pwa.mjs",
    "test": "npx tsx test_config.mjs && npx tsx test_globalsend.mjs && npx tsx test_telegram_storage.mjs && npx tsx test_crypto.mjs && npx tsx test_phase1_resumable.mjs && npx tsx test_phase2_folders_trash.mjs && npx tsx test_phase3_shares_access.mjs && npx tsx test_phase4_trust_safety.mjs && npx tsx test_phase5_previews_pwa.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@libsql/client": "^0.18.0",
    "@noble/hashes": "^2.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "in.gsend.vault.desktop",
    "productName": "Global Send",
    "npmRebuild": false,
    "directories": {
      "output": "release-desktop-v3"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      ".next/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
